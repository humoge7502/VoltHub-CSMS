# VoltHub CSMS — environment template.
# Copy to .env for compose, or export the values for a bare-metal run.
# Every variable below is read by first-party code (grep `process.env.`), grouped by
# the component that owns it. Defaults are the values the code falls back to when the
# variable is unset — `NODE_ENV=production` additionally refuses to boot with a
# missing/default JWT_SECRET or INTERNAL_TOKEN (see SECURITY.md, "Boot discipline").

# ---------------------------------------------------------------- Oracle 23ai
# ORACLE_HOST unset => the local in-process store (ADR-0005 local profile). Set it to
# arm the durable write-through engine. The API hydrates its read-cache on boot and
# seeds only when the database is genuinely empty.
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE=freepdb1
ORACLE_USER=volthub
ORACLE_PASSWORD=change_me
# Connection-pool ceiling. 8 is the measured default; pool saturation is only
# observable against a live Oracle (docs/perf.md lists this as a full-profile item).
ORACLE_POOL_MAX=8

# ------------------------------------------------------------- TimescaleDB
# Telemetry sink for the worker relay (ADR-0002/0003). Unset => the worker writes the
# local JSONL mirror instead, and /health reports `local-rollup` rather than pretending.
TS_HOST=localhost
TS_PORT=5432
TS_DB=volthub
TS_USER=volthub
TS_PASSWORD=change_me
# TS_PASS is accepted as an alias for TS_PASSWORD (relay-timescale.js).

# ------------------------------------------------------------------- API
PORT=4000
# API_PORT is accepted as an alias for PORT.
JWT_SECRET=replace_with_32_random_bytes
INTERNAL_TOKEN=replace_with_a_random_worker_token
# Comma-separated CORS allow-list — never '*'. Add your console origin(s).
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=info
# demo | full | empty. `empty` boots with no seeded rows.
SEED_PROFILE=demo
# Base URL the worker and the simulator call.
API_BASE=http://localhost:4000/api/v1
# Trust proxy headers. Leave UNSET unless a reverse proxy terminates TLS in front of
# the API (DEPLOY.md Caddy profile) — the default sees every client as one IP, which
# collapses the per-IP login throttle into a platform-wide login outage.
#   TRUST_PROXY=1        one hop
#   TRUST_PROXY=loopback same-host proxy
# TRUST_PROXY=1
# Rate limiting. RATE_LIMIT_OFF=1 disables every tier — for k6/load runs only.
# RATE_LIMIT_USER overrides the per-role cap (default 60/min DRIVER, 120/min staff).
RATE_LIMIT_OFF=0
# RATE_LIMIT_USER=100000

# ------------------------------------------------------- OCPP 1.6J gateway
# per-cp (default: Basic auth against the charge point's own secret) | require | off.
OCPP_AUTH=per-cp
# Milliseconds to wait for a CALLRESULT before sweeping the call to ACK_TIMEOUT.
# An unanswered actuation is never assumed successful.
OCPP_ACK_TIMEOUT_MS=10000
# Simulator only: shared secret when provisioning simulated charge points. `dev-<identity>`
# is used per-CP when unset; OCPP_SECRET_<IDENTITY> overrides an individual point.
OCPP_SECRET=change_me

# --------------------------------------------------------------- AI sidecar
# Advisory-only FastAPI service (ADR-0008). The API degrades to 503 AI_UNAVAILABLE
# when it is not reachable — it never fabricates a forecast.
AI_URL=http://127.0.0.1:8100
AI_TOKEN=change_me
AI_TIMEOUT_MS=3000

# ----------------------------------------------- FC-HCC control-loop tuning
# Fractions/quantities, not percentages. See docs/adr/0014-control-loop-closure.md.
FCHCC_TARGET_SOC=0.8
FCHCC_RESERVE=0.1
FCHCC_MARGIN_KWH=2
FCHCC_HYSTERESIS_MIN=5
# FCHCC_ACCEPTANCE_AWARE=0 reproduces the pre-ADR-0015 power-based allocator (bench arm).
FCHCC_ACCEPTANCE_AWARE=1

# ------------------------------------------------------------------- Web
NEXT_PUBLIC_API_BASE=http://localhost:4000/api/v1
# Canonical origin for metadata/canonical/OpenGraph + sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
