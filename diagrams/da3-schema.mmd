%% VoltHub CSMS — DA3 TimescaleDB schema (Section 26)
%% Render: bash scripts/render-diagrams.sh  ->  diagrams/out/da3-schema.{svg,png}
flowchart TB
    subgraph Raw["Raw hypertables"]
        direction LR
        MT["meter_tick<br/>ts TIMESTAMPTZ · 1d chunks<br/>session_id, connector_ref<br/>meter_kwh, power_kw, voltage_v, current_a<br/>PK (session_id, ts) = idempotency"]
        CSE["connector_state_event<br/>ts TIMESTAMPTZ · 1d chunks<br/>connector_ref, from_state, to_state<br/>cause, session_id<br/>PK (connector_ref, ts)"]
        SM["session_metric<br/>ts TIMESTAMPTZ · 7d chunks<br/>session_id, station_id<br/>energy_kwh, duration_s, peak_kw"]
    end

    subgraph Caggs["Continuous aggregates — incremental"]
        direction LR
        C1["tick_1m<br/>time_bucket 1min<br/>delta_kwh, avg_kw, peak_kw<br/>refresh every 1 min"]
        C2["tick_1h<br/>time_bucket 1h<br/>cagg over cagg"]
        C3["state_1m<br/>dominant_state per min<br/>fault / offline counts"]
    end

    subgraph Meta["Reference — projected from Oracle"]
        MAP["station_map<br/>connector_ref → station_id<br/>standard_code, max_power_kw"]
    end

    subgraph Policies["Automated policies"]
        direction LR
        P1["compression<br/>meter_tick > 7 days<br/>segmentby connector_ref"]
        P2["retention<br/>meter_tick > 90 days"]
        P3["retention<br/>state events > 180 days"]
    end

    MT -->|"GROUP BY bucket, connector"| C1
    C1 -->|"re-aggregate"| C2
    CSE -->|"dominant state"| C3
    MAP -.->|"enrichment join"| C1
    MAP -.->|"enrichment join"| C3
    P1 -.->|"compress"| MT
    P2 -.->|"drop chunks"| MT
    P3 -.->|"drop chunks"| CSE

    classDef raw fill:#151a20,stroke:#c6f24e,stroke-width:1.5px,color:#fffdd0
    classDef cagg fill:#101418,stroke:#3a444e,color:#fffdd0
    classDef ref fill:#101418,stroke:#8a949f,stroke-dasharray:4 3,color:#c9d1d9
    class MT,CSE,SM raw
    class C1,C2,C3 cagg
    class MAP,P1,P2,P3 ref
